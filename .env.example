# Riot Games API key, from https://developer.riotgames.com
# Without it the site runs on generated sample data.
# Development keys expire every 24 hours; a production key needs an approved app.
RIOT_API_KEY=

# Optional. Postgres for rank history and champion statistics, e.g. from Neon
# or Supabase. Without it, data is kept in .data/buddy.json, which hosts with
# no lasting disk (Vercel included) throw away.
# DATABASE_URL=postgres://user:password@host:5432/buddy

# Optional. Protects /api/cron/collect outside development. Vercel Cron sends
# it automatically when set in the project's environment variables.
# CRON_SECRET=

# Optional. Where the privacy page sends questions and removal requests,
# e.g. mailto:you@example.com or a contact form's address.
# CONTACT_URL=

# Optional. How many lookups one visitor may make. Defaults: 10 and 100.
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_HOUR=100

# Optional. Regions the collector visits, comma separated. Default: euw.
# COLLECT_REGIONS=euw,na

# Optional. Where to keep the JSON file when there is no database.
# BUDDY_DATA_FILE=.data/buddy.json

# Optional. Send Riot API calls somewhere else (a caching proxy, a local stub).
# "{host}" is replaced with the routing value, e.g. "euw1" or "europe".
# RIOT_API_BASE_URL=http://localhost:4000/{host}
